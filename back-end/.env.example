# Backend configuration (see app/config.py). Copy to back-end/.env and adjust.
# `uv run lineage-api` (and ./dev.sh) load it at startup; variables already set in the
# shell take precedence. Relative paths are resolved against this folder (back-end/).

# Which pipelines (= dbt projects) to load and where their manifest/catalog live:
PIPELINES_CONFIG=../fixtures/pipelines.yaml
# dbt used for `dbt docs generate` when a pipeline has a project_dir (default: dbt on PATH):
# DBT_EXECUTABLE=C:/Users/me/.venvs/dbt/Scripts/dbt.exe
# BQ_CONSOLE_PROJECT=pnc-analytics-exp
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
